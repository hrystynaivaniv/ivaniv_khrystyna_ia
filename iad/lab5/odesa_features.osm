    <tag k="name" v="Меморіал пам'яті жертв фашизму 1941-1944"/>
    <tag k="name:ru" v="Мемориал памяти жертв фашизма 1941-1944"/>
    <tag k="name:uk" v="Меморіал пам'яті жертв фашизму 1941-1944"/>
