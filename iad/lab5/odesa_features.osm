  <node id="10815821465" lat="46.4270769" lon="30.7500813">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Улица названа в честь Героя Советского Союза Кондрашина Андрея Кузьмича, командира эскадрильи, участника обороны г. Одессы, погиб в 1944 г."/>
    <tag k="memorial" v="plaque"/>
    <tag k="openplaques:id" v="58656"/>
  </node>
  <node id="10815847098" lat="46.4194840" lon="30.7619159">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Координаты: 46°25'37 Сев. широты; 30°46'45 Вост. долготы. Здесь, во время Крымской войны, у берега Среднего Фонтана, 30 апреля (12 мая по нынешнему календарю) 1854 года, в густом тумане, сел на мель фрегат Британского Королевского Флота &quot;Тигр&quot;. […]"/>
    <tag k="memorial" v="plaque"/>
    <tag k="openplaques:id" v="58524"/>
  </node>
  <node id="10815847099" lat="46.4194971" lon="30.7619132">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="На этой территории, на месте парка &quot;Юность&quot;, до начала 1960-х годов располагались позиции береговой стационарной батареи БС-39 42-го отдельного артдивизиона Одесской военно-морской базы, вооружённой тремя 203-миллиметровыми дальнобойными орудиями. […]"/>
    <tag k="memorial" v="plaque"/>
    <tag k="openplaques:id" v="58523"/>
  </node>
