  <node id="5799469442" lat="46.4262263" lon="30.7264973">
    <tag k="architect" v="В.Г. Лобків"/>
    <tag k="architect:en" v="V.G. Lobkov"/>
    <tag k="artist_name" v="С.Д. Голованов"/>
    <tag k="artist_name:en" v="S.D. Golovanov"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Пам'ятайте! Тут, на території колишніх порохових складів, у період фашистської окупації 1941–1944 рр. були розстріляні та спалені військовополонені, моряки та солдати, тисячі мирних жителів Одеси різних національностей."/>
    <tag k="inscription:ru" v="Помните! Здесь, на территории бывших пороховых складов, в период фашистской оккупации 1941–1944 гг. были расстреляны и сожжены военнопленные, моряки и солдаты, тысячи мирных граждан Одессы разных национальностей."/>
    <tag k="inscription:uk" v="Пам'ятайте! Тут, на території колишніх порохових складів, у період фашистської окупації 1941–1944 рр. були розстріляні та спалені військовополонені, моряки та солдати, тисячі мирних жителів Одеси різних національностей."/>
    <tag k="material" v="gabbro"/>
    <tag k="memorial" v="stone"/>
    <tag k="name" v="У пам'ять розстріляних і спалених євреїв (1941–1944)"/>
    <tag k="name:ru" v="В память расстрелянных и сожжённых евреев (1941–1944)"/>
    <tag k="name:uk" v="У пам'ять розстріляних і спалених євреїв (1941–1944)"/>
    <tag k="official_name" v="Пам’ятник жертвам фашизму (меморіал)"/>
    <tag k="official_name:en" v="Monument to the Victims of Fascism (memorial)"/>
    <tag k="official_name:ru" v="Памятник жертвам фашизма (мемориал)"/>
    <tag k="start_date" v="1975"/>
    <tag k="website" v="https://kpsc.od.ua/qr-monument-zertvam-fashizma/"/>
  </node>
